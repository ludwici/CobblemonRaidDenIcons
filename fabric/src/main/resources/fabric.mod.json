  "mixins": ["cri.mixins.json"],
  "depends": {
    "fabricloader": ">=0.17.3",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "architectury": ">=13.0.8",
    "cobblemon": ">=1.8.1",
    "cobblemonraiddens": ">=0.13.2"
  }
